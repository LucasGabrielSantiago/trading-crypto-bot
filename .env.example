# Chaves da Spot Testnet (https://testnet.binance.vision). Nunca use chaves da conta real.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Até 8 pares em USDT, separados por vírgula. O capital é dividido igualmente.
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=4h

# ranges: compra perto da mínima da região e mira a máxima. sma: médias móveis.
STRATEGY=ranges
LOOKBACK=60
ZONE_PCT=0.15
STOP_BUFFER_PCT=0.005
MIN_REWARD_RISK=1.5
MIN_RANGE_PCT=0.04
STOP_LIMIT_BUFFER_PCT=0.005

FAST_SMA=20
SLOW_SMA=50

# Capital que o bot pode usar, mesmo que a conta de teste tenha mais saldo
CAPITAL_USDT=1000
RISK_PER_TRADE=0.01
STOP_LOSS_PCT=0.03
MAX_POSITION_PCT=0.25
MAX_DAILY_LOSS_PCT=0.03

POLL_SECONDS=30
DB_PATH=bot.db
KILL_FILE=STOP

# Só para o Docker. Troque antes do primeiro início.
POSTGRES_PASSWORD=troque_esta_senha
